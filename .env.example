# Copy to .env and fill in real values. NEVER commit .env.
ENV=dev
# prod refuses dev settings: weak secrets, console SMS, localhost CORS, default DB password
DATABASE_URL=postgresql+psycopg://showcase:CHANGE_ME@localhost:5432/showcase
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
# Used by docker-compose for the redis container (also put it in REDIS_URL above)
REDIS_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 32   (the app refuses to start with this placeholder)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Admins are logged out this many hours after login, even if active
ADMIN_SESSION_HOURS=12

PUBLIC_BASE_URL=http://localhost:3000
# JSON list of frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]

# Used by docker-compose for the postgres container
POSTGRES_USER=showcase
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=showcase

# Razorpay (retailer plan billing). Leave empty until the account is ready: admins can still record payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# THE-MANAGER wallet integration (SPEC 4.11). Must be the SAME value as ECOM_STORE_API_KEY in THE-MANAGER's .env
THE_MANAGER_BASE_URL=http://localhost:8000
THE_MANAGER_API_KEY=

# OTP SMS. "console" prints codes to the log and only works with ENV=dev/test. A real provider is needed for prod.
SMS_PROVIDER=console
# Reverse proxy IP/CIDR whose X-Forwarded-For is trusted (client IP for rate limits)
FORWARDED_ALLOW_IPS=127.0.0.1
