# Copy to .env and fill in real values. NEVER commit .env.
ENV=dev
DATABASE_URL=postgresql+psycopg://showcase:CHANGE_ME@localhost:5432/showcase
REDIS_URL=redis://localhost:6379/0

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

PUBLIC_BASE_URL=http://localhost:3000
# JSON list of frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]

# Used by docker-compose for the postgres container
POSTGRES_USER=showcase
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=showcase

# THE-MANAGER wallet integration (SPEC 4.11). Must be the SAME value as ECOM_STORE_API_KEY in THE-MANAGER's .env
THE_MANAGER_BASE_URL=http://localhost:8000
THE_MANAGER_API_KEY=
